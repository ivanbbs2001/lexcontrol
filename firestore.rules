rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Só as duas contas do escritório (criadas manualmente no console) leem/gravam.
    // Mesmo que alguém crie outra conta pela API pública, o e-mail não confere e o acesso é negado.
    function autorizado() {
      return request.auth != null
        && request.auth.token.email in [
          'juliana@lexcontrol.app',
          'ivan@lexcontrol.app'
        ];
    }
    match /workspaces/{workspaceId}/data/{document} {
      allow read, write: if autorizado();
    }
  }
}
